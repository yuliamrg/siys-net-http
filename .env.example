SIYS_BASE_URL=https://app.siys.net
SIYS_API_URL=https://api.siys.net/api
SIYS_LOGIN_URL=https://api.siys.net/login
SIYS_EMAIL=
SIYS_PASSWORD=
# Timeout total para lecturas y login, entre 1000 y 300000 ms. Default: 30000.
SIYS_HTTP_TIMEOUT_MS=30000

# Análisis visual opcional de fotografías HVAC. No guardar la clave en Git.
OPENAI_API_KEY=
SIYS_VISION_MODEL=gpt-5.4-mini
# Do not commit a real token. Prefer SIYS_EMAIL/SIYS_PASSWORD or the token stored by siys login.
SIYS_TOKEN=
